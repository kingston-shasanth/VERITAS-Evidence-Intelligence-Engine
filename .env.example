# ==============================================================================
# VERITAS-X Environment Configuration Template
# ==============================================================================

# Backend Python API Server
VERITAS_API_HOST=127.0.0.1
VERITAS_API_PORT=8011
# Compute device: "cuda" for GPU acceleration, "cpu" for CPU fallback
VERITAS_DEVICE=cuda

# Frontend React/Vite Client
# Set true for safe illustrative walkthrough without calling local backend
VITE_DEMO_MODE=false
# Backend target URL (Dedicated port 8011)
VITE_API_BASE_URL=http://127.0.0.1:8011

# Live Web Evidence Retrieval (Tavily Search API)
# Get a free API key at https://app.tavily.com/
TAVILY_API_KEY=replace_with_your_key
